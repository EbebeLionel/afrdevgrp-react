# Copy to .env.local for local development. Set the same two values in Vercel.
# Both come from Supabase -> Project Settings -> API. They are safe to expose
# in the browser; permissions are enforced by the database.
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Only for scripts/migrate-from-firebase.mjs. NEVER put this in Vercel or in
# any REACT_APP_ variable: it bypasses all security rules.
# SUPABASE_SERVICE_ROLE_KEY=
