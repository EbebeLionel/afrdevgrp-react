rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check authorized emails
    function isAuthorizedEmail() {
      return isAuthenticated() && (
        request.auth.token.email == 'adg.columbia@gmail.com' ||
        request.auth.token.email == 'em3820@columbia.edu' ||
        request.auth.token.email == 'fg2571@barnard.edu' ||
        request.auth.token.email == 'makumbalionel@gmail.com'
      );
    }

    // Helper function to validate event data
    function isValidEvent() {
      let event = request.resource.data;
      return event.keys().hasAll(['name', 'type', 'date', 'uploadedBy', 'uploadedAt'])
          && event.name is string && event.name.size() > 0
          && event.type is string && event.type.size() > 0
          && event.date is string;
    }

    // Helper function to validate reel data
    function isValidReel() {
      let reel = request.resource.data;
      return reel.keys().hasAll(['uploadedBy', 'createdAt', 'media', 'caption'])
          && reel.uploadedBy is string
          && reel.media is list
          && reel.media.size() > 0
          && reel.caption is string;
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Anyone can read user profiles (public info)
      allow read: if true;

      // Users can create and update their own profile
      allow create, update: if isAuthenticated();

      // Users can delete their own profile
      allow delete: if isAuthenticated();
    }

    // ============================================
    // EVENTS COLLECTION
    // ============================================
    match /events/{eventId} {
      // Anyone can read events (public content)
      allow read: if true;

      // Only authorized emails can create events
      allow create: if isAuthorizedEmail() && isValidEvent();

      // Only authorized emails can update events
      allow update: if isAuthorizedEmail();

      // Only authorized emails can delete events
      allow delete: if isAuthorizedEmail();
    }

    // ============================================
    // REELS COLLECTION
    // Comments are stored as arrays in the main document
    // ============================================
    match /reels/{reelId} {
      // Anyone can read reels (public content)
      allow read: if true;

      // Only authorized emails can create reels
      allow create: if isAuthorizedEmail() && isValidReel();

      // Any authenticated user can update reels (for likes and comments)
      // OR authorized emails can update anything
      allow update: if isAuthenticated() || isAuthorizedEmail();

      // Only authorized emails can delete reels
      allow delete: if isAuthorizedEmail();
    }

    // ============================================
    // DENY ALL OTHER COLLECTIONS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}