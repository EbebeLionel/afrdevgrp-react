# Non-secret defaults, committed on purpose. Override in Vercel
# (Project Settings -> Environment Variables) or in .env.local.

# The public address of the site, no trailing slash. Used for the canonical
# URL, social previews, sitemap.xml and robots.txt. Change this if the Vercel
# project gets a different name or a custom domain.
REACT_APP_SITE_URL=https://african-development-group-columbia.vercel.app
