rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check authorized emails
    function isAuthorizedEmail() {
      return isAuthenticated() && (
        request.auth.token.email == 'adg.columbia@gmail.com' ||
        request.auth.token.email == 'em3820@columbia.edu' ||
        request.auth.token.email == 'fg2571@barnard.edu' ||
        request.auth.token.email == 'makumbalionel@gmail.com'
      );
    }

    // Helper function to validate image files
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024 // 10MB max
          && request.resource.contentType.matches('image/.*');
    }

    // Helper function to validate video files
    function isValidVideo() {
      return request.resource.size < 100 * 1024 * 1024 // 100MB max
          && request.resource.contentType.matches('video/.*');
    }

    // Helper function to validate any media file (image or video)
    function isValidMedia() {
      return isValidImage() || isValidVideo();
    }

    // ============================================
    // EVENTS STORAGE RULES
    // Path: /events/{userId}/{eventId}/{filename}
    // ============================================
    match /events/{userId}/{eventId}/{filename} {
      // Anyone can read event photos (public content)
      allow read: if true;

      // Only authorized emails can upload event photos
      allow create: if isAuthorizedEmail() && isValidImage();

      // Only authorized emails can update or delete event photos
      allow update, delete: if isAuthorizedEmail();
    }

    // ============================================
    // REELS STORAGE RULES
    // Path: /reels/{userId}/{reelId}/media/{mediaId}
    // ============================================
    match /reels/{userId}/{reelId}/media/{mediaId} {
      // Anyone can read reel media (public content)
      allow read: if true;

      // Only authorized emails can upload reels (both images and videos)
      allow create: if isAuthorizedEmail() && isValidMedia();

      // Only authorized emails can update or delete reel media
      allow update, delete: if isAuthorizedEmail();
    }

    // ============================================
    // USER PROFILE STORAGE RULES
    // Path: /users/{userId}/profile/{filename}
    // ============================================
    match /users/{userId}/profile/{filename} {
      // Anyone can read user profile photos
      allow read: if true;

      // Only authenticated users can upload/update their own profile photo
      allow create, update: if isAuthenticated() && isValidImage();

      // Only the user can delete their profile photo
      allow delete: if isAuthenticated();
    }

    // ============================================
    // DENY ALL OTHER PATHS
    // ============================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}